@{
    ViewData["Title"] = "Home Page";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-dark">
            <i class="bi bi-trophy text-warning"></i> Welcome to RaceDay
        </h1>
        <p class="col-md-8 fs-4 text-secondary">
            Discover local running and cycling events, sign up as a participant, or manage your own races as an organiser.
        </p>
        <div class="mt-4">
            @if (Context.Session.GetString("UserEmail") == null)
            {
            <a class="btn btn-warning btn-lg text-dark fw-bold px-4 me-2 shadow-sm" asp-controller="Account" asp-action="Register">
                Get Started &rarr;
            </a>
            <a class="btn btn-outline-dark btn-lg px-4" asp-controller="Account" asp-action="Login">
                Sign In
            </a>
            }
            else
            {
            <a class="btn btn-primary btn-lg px-4 shadow-sm" asp-controller="Home" asp-action="Index">
                Browse Upcoming Events
            </a>
            }
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="fs-1 text-warning mb-3"><i class="bi bi-calendar-event"></i></div>
                <h3 class="h5 fw-bold">Explore Events</h3>
                <p class="text-muted">Browse upcoming races, check distances, entry fees, and category schedules.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="fs-1 text-primary mb-3"><i class="bi bi-person-badge"></i></div>
                <h3 class="h5 fw-bold">Participant Portal</h3>
                <p class="text-muted">Enrol in categories, track your bib numbers, manage profile info, and view final race times.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <div class="fs-1 text-success mb-3"><i class="bi bi-speedometer2"></i></div>
                <h3 class="h5 fw-bold">Organiser Tools</h3>
                <p class="text-muted">Create custom race events, set up categories, view enrolments, and capture finish-line results.</p>
            </div>
        </div>
    </div>
</div>