@model List<RaceDay.Mvc.Models.ParticipantEnrolmentViewModel>
    @{
    ViewData["Title"] = "My Race Enrolments";
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-card-checklist text-primary me-2"></i>My Enrolments</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm">Browse More Races</a>
    </div>

    @if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <h5>No active registrations found.</h5>
    </div>
}
else
{
    <div class="table-responsive bg-white rounded shadow-sm p-3">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Bib Number</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Status switch {
                        "Confirmed" => "badge-confirmed",
                        "Pending" => "badge-pending",
                        _ => "badge-withdrawn"
                    };
                <tr>
                    <td class="fw-bold">@item.EventName</td>
                    <td>@item.CategoryName (@item.DistanceKm km)</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td><span class="badge bg-dark font-monospace">@item.BibNumber</span></td>
                    <td><span class="badge @badgeClass">@item.Status</span></td>
                    <td>
                        @if (item.Status == "Confirmed")
                            {
                        <form asp-action="Withdraw" method="post" onsubmit="return confirm('Confirm cancellation of entry?');">
                            <input type="hidden" name="enrolmentId" value="@item.EnrolmentID" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Withdraw</button>
                        </form>
                            }
                            else
                            {
                        <span class="text-muted small">Withdrawn</span>
                            }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
}
