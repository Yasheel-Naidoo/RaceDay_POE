@model RaceDay.Mvc.Models.OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Organiser Command Center";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2 text-warning me-2"></i>Organiser Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Host New Event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white p-3 border-0 shadow-sm">
            <h3>@Model.TotalEventsCreated</h3>
            <div>Total Managed Events</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white p-3 border-0 shadow-sm">
            <h3>@Model.UpcomingRacesCount</h3>
            <div>Upcoming Races</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-dark text-white p-3 border-0 shadow-sm">
            <h3>@Model.TotalActiveEnrolments</h3>
            <div>Aggregate Athlete Entries</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm p-3">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Status</th>
                <th>Categories</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model.ManagedEvents)
            {
            <tr>
                <td class="fw-bold">@ev.EventName</td>
                <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                <td><span class="badge @(ev.Status == "Open" ? "bg-success" : "bg-danger")">@ev.Status</span></td>
                <td>@ev.Categories.Count Categories</td>
                <td>
                    <a asp-action="ManageRoster" asp-route-id="@ev.EventID" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-people me-1"></i>Enrolment Roster & Results
                    </a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>